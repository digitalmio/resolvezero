{
  "name": "resolvezero",
  "private": true,
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p apps/edge --noEmit && tsc -p apps/control --noEmit && tsc -p packages/db --noEmit",
    "db:generate": "pnpm --filter '@resolvezero/db' db:generate",
    "db:migrate": "pnpm --filter '@resolvezero/db' db:migrate",
    "db:push": "pnpm --filter '@resolvezero/db' db:push",
    "db:studio": "pnpm --filter '@resolvezero/db' db:studio"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "tsx": "^4.19.0",
    "yaml": "^2.9.1"
  }
}

# Artifact compiler worker (dedicated Fly machine, Cargo workspace).
FROM rust:1.99-bookworm AS build
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps/edge ./apps/edge
COPY apps/compiler ./apps/compiler
RUN cargo build --release --locked -p resolvezero-compiler --bin rz-compiler

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/rz-compiler /usr/local/bin/rz-compiler
ENV HOME=/tmp
CMD ["/usr/local/bin/rz-compiler"]

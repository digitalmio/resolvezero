# ---- resolvezero edge ----
# copy to .env (gitignored) and fill in

# Postgres (PlanetScale Postgres / any Postgres). Required.
# On PlanetScale use the PgBouncer port (6432) for runtime. Direct port
# 5432 has a much smaller connection limit and is reserved for migrations
# (DATABASE_URL_ADMIN).
DATABASE_URL=postgres://user:password@host:6432/db?sslmode=prefer

# HTTP port for the DoH + stats + logs endpoints
PORT=8080

# UDP/TCP DNS port (Rust edge). Port 53 needs root or CAP_NET_BIND_SERVICE.
#DNS_PORT=53
# DNS-over-TLS (Rust edge). TLS is terminated by Fly's proxy in production.
#DOT_ENABLED=1
#DOT_PORT=853
#DOT_SUFFIX=.dot.resolvezero.com

# Blocklists load lazily per profile on the first query (Rust edge). Set this
# to 1 to preload every list at startup instead.
#EAGER_BLOCKLISTS=0
# Retry delay after a failed lazy load.
#BLOCKLIST_LAZY_RETRY_SECONDS=60
# Hosted default: never parse raw list text; wait for the compiler artifact.
# Self-hosters with no compiler should leave this at 0 or use EAGER_BLOCKLISTS=1.
#ARTIFACT_ONLY_LISTS=1
# Prefix for compiled, content-addressed artifacts in the S3 bucket.
#ARTIFACT_PREFIX=artifacts
# Compiler liveness heartbeat (seconds).
#COMPILER_HEARTBEAT_SECONDS=15

# App log level (pino): trace|debug|info|warn|error
LOG_LEVEL=info

# Upstream DoH resolver (readme §2). Per-profile overrides live on the
# profiles row (`upstream` selector or `upstream_url`). Edge default:
# preset selector OR custom URL. NOTE: Quad9 505s Bun's HTTP/1.1 fetch
# ("requires HTTP/2") — Cloudflare is the verified default.
#UPSTREAM_PRESET=cloudflare   # cloudflare | google | quad9
#UPSTREAM_DOH_URL=            # custom URL wins over the preset

# Fly injects FLY_REGION automatically at deploy; local dev omits it.
#FLY_REGION=lhr
# Hosted mode is explicit. HOSTED=1 wins over ENVIRONMENT/FLY_REGION detection.
# It controls tokenless-profile rejection, per-instance limits, and the
# artifact-only default. Self-hosted deployments leave it unset/0.
#HOSTED=0
#ENVIRONMENT=production

# Resolver-presence canary for the console ("is this browser using our DNS?").
# This name MUST NOT have a public DNS record. The edge answers randomly
# generated <nonce>.<PROBE_DOMAIN> probes with NXDOMAIN after auth.
#PROBE_DOMAIN=probe.resolvezero.com

# Credentials for scripts/probe-blocks.ts. Never commit real values.
#PROBE_PROFILE_ID=
#PROBE_DOH_TOKEN=

# ---- Edge abuse controls (process-local, per PoP) ----
# These bound work before/around upstream resolution. Tune for your traffic.
#DOH_RATE_LIMIT_PER_MIN=6000
#DOH_MAX_INFLIGHT=512
#UDP_RATE_LIMIT_PER_MIN=6000
#UDP_MAX_INFLIGHT=1024
#TCP_MAX_CONNECTIONS=512
#TCP_MAX_PER_SOURCE=32
#DOT_MAX_PER_SOURCE=16
#BLOCKLIST_MAX_UNIQUE_LISTS=256
#BLOCKLIST_MAX_LISTS_PER_PROFILE=64
# Global rule budget. 64M is the 1GB worst case for 128 unique 0.5M lists;
# shared list URLs count once, so typical deployments need far less.
#BLOCKLIST_MAX_TOTAL_ENTRIES=64000000
# Per-profile list budget. One 0.5M-rule list + the small custom-rule layer.
#BLOCKLIST_MAX_ENTRIES_PER_PROFILE=500000
#BLOCKLIST_CYCLE_DEADLINE_MS=180000
#S3_MAX_STAGED_BYTES=67108864
#S3_MAX_PENDING_BYTES=134217728

# ---- Raw query-log persistence ----
# The Rust edge stages query events in Postgres and uploads one-minute
# compressed NDJSON windows straight to S3. Configure any S3-compatible
# provider: iDrive E2, Cloudflare R2, Tigris, AWS S3.
#S3_BUCKET=resolvezero-logs
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Endpoint override for S3-compatible providers (required for E2/R2)
#S3_ENDPOINT=https://s3.us-east-1.idrivee2-XX.com
# Region (R2 uses "auto")
#S3_REGION=auto
# One compressed NDJSON object per one-minute window per profile.
# Object key root: {S3_LOG_PREFIX}/{profile_id}/{date}/{HHmm}.{seq}.jsonl.gz
#S3_LOG_PREFIX=logs

# ---- TanStack console auth (better-auth) ----
# Local dev: http://localhost:3000. Production: the console origin.
#BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
#BETTER_AUTH_SECRET=
# GitHub OAuth app — register {BETTER_AUTH_URL}/api/auth/callback/github
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
# Extra allowed origins (comma-separated) when the console is not same-origin.
#TRUSTED_ORIGINS=

# ---- Email OTP sign-in (the only human auth method) ----
# Any SMTP endpoint works: Resend, Postmark, SES, Mailgun, your own server.
# Format: smtps://user:pass@smtp.example.com:465  (or smtp://…:587)
# Required in production. Without it, dev logs the code to the console.
#SMTP_URL=
# From address for sign-in codes.
#EMAIL_FROM="ResolveZero <login@example.com>"
# Code lifetime in seconds (default 600).
#EMAIL_OTP_TTL_SECONDS=600
# Set to 1 to log codes instead of sending, even with NODE_ENV=production.
#EMAIL_OTP_DEV_LOG=0
# Set to 0 to close account creation for both GitHub and email OTP. Existing
# accounts still sign in. Hosted production sets this to 0.
#AUTH_ALLOW_SIGNUP=0

# ---- OTP abuse limits (protect the email bill) ----
# Per-IP throttling is built into Better Auth; these add per-recipient and
# per-instance caps. Defaults shown. Set AUTH_RATE_LIMIT=0 to disable the per-IP
# limiter in local development.
#EMAIL_OTP_PER_EMAIL_MAX=3
#EMAIL_OTP_PER_EMAIL_WINDOW_MS=900000
#EMAIL_OTP_GLOBAL_MAX=100
#EMAIL_OTP_GLOBAL_WINDOW_MS=3600000

# Rust edge production image (root build context, Cargo workspace).
FROM rust:1.99-bookworm AS build
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps/agent ./apps/agent
COPY apps/edge ./apps/edge
COPY apps/compiler ./apps/compiler
RUN cargo build --release --locked -p resolvezero-edge --bin resolvezero-edge

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/resolvezero-edge /usr/local/bin/resolvezero-edge
ENV HOME=/tmp
EXPOSE 8080 9091 53 53/udp 853
# Binds 53/853 as root, then drops to UID/GID 1000 (checked).
CMD ["/usr/local/bin/resolvezero-edge"]
